rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /friends/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members
                    && request.resource.data.from == request.auth.uid;
      allow update: if request.auth != null && request.auth.uid in resource.data.members
                    && request.auth.uid != resource.data.from;
      allow delete: if request.auth != null && request.auth.uid in resource.data.members;
    }
    match /msgs/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.pair.split('_');
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid
                    && request.auth.uid in request.resource.data.pair.split('_');
    }
    match /stories/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
